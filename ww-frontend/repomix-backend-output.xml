        console.error('Error fetching branches:', error);
      }
    };
    fetchBranches();
    return () => { isMounted = false; };
  }, []);

  const fetchDashboardData = async (branchId) => {
    setIsLoading(true);
    try {
      const query = branchId ? `?branch_id=${branchId}` : '';
