          // ถ้า Token หมดอายุหรือไม่ถูกต้อง
          localStorage.clear();
          navigate('/login', { replace: true });
        }
      })
      .catch(err => {
        console.error('Error fetching menus:', err);
      });
  }, [navigate, location.pathname]);

