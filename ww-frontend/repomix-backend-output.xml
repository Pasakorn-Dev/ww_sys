          </div>
        </div>

        <div className="mt-6 flex flex-wrap justify-between items-center gap-4">
          <button onClick={handleSearch} disabled={isLoading} className="bg-teal-600 hover:bg-teal-700 text-white px-6 py-2 rounded-lg font-semibold shadow">
