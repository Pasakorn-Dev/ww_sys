<file path="src/pages/WetWoodPerformanceReport.jsx">
import React, { useState, useEffect } from 'react';
import Swal from 'sweetalert2';
import apiFetch, { API_URL } from '../services/apiFetch';
import DatePicker from 'react-datepicker';
import 'react-datepicker/dist/react-datepicker.css';
import { th } from 'date-fns/locale';
import { format, parseISO } from 'date-fns';

// ─── Component ย่อยสำหรับแสดงตาราง ───
const ReportTable = React.memo(({ data, grandTotal, expectedColumns, showFooter }) => {
  // ฟังก์ชันตัวช่วยดึงชื่อคอลัมน์ (ตามเกรด) ให้กระชับขึ้น
  const getColumnLabel = (col) => {
    return `ไม้แปรรูปอบแห้ง ${col.grade}${col.is_special ? ' (พิเศษ)' : ''}`;
  };

  return (
    <div className="overflow-x-auto pb-4">
      <table className="w-full text-[11px] md:text-[12px] border-collapse border border-gray-400 whitespace-nowrap min-w-max text-center">
        <thead>
          {/* แถวหัวตารางชั้นที่ 1 (ชื่อเกรด) */}
          <tr className="bg-gray-300 text-gray-800 font-bold border-y-2 border-gray-500">
            <th rowSpan="2" className="border border-gray-400 p-2 align-middle w-16">รหัส</th>
            <th rowSpan="2" className="border border-gray-400 p-2 align-middle min-w-[200px] text-left">ชื่อพนักงาน</th>
            
            {expectedColumns.map((col, idx) => (
              <th key={idx} colSpan="2" className="border border-gray-400 p-2 align-middle">
                {getColumnLabel(col)}
              </th>
            ))}
            
            <th colSpan="2" className="border border-gray-400 p-2 align-middle bg-gray-400">
              รวม
            </th>
          </tr>
          {/* แถวหัวตารางชั้นที่ 2 (ปริมาตร / จำนวนเงิน) */}
          <tr className="bg-gray-200 text-gray-700 font-semibold border-b-2 border-gray-400">
            {expectedColumns.map((_, idx) => (
              <React.Fragment key={`sub-${idx}`}>
                <th className="border border-gray-400 p-1 min-w-[70px]">ปริมาตร</th>
                <th className="border border-gray-400 p-1 min-w-[80px]">จำนวนเงิน</th>
              </React.Fragment>
            ))}
            <th className="border border-gray-400 p-1 min-w-[70px] bg-gray-300">ปริมาตร</th>
            <th className="border border-gray-400 p-1 min-w-[80px] bg-gray-300">จำนวนเงิน</th>
          </tr>
        </thead>
        
        <tbody>
          {data.length > 0 ? (
            data.map((emp, index) => (
              <tr key={index} className="bg-white hover:bg-gray-50">
                <td className="border border-gray-400 p-1.5 text-center text-gray-600">{emp.employee_code}</td>
                <td className="border border-gray-400 p-1.5 text-left font-medium text-gray-800">{emp.employee_name}</td>
                
                {/* ข้อมูลของแต่ละเกรด */}
                {expectedColumns.map((col, cIdx) => {
                  const colKey = `${col.grade}_${col.is_special ? 'spc' : 'norm'}`;
                  const cellData = emp.grades[colKey];
                  return (
                    <React.Fragment key={cIdx}>
                      <td className="border border-gray-400 p-1 text-right text-gray-800">
                        {cellData && cellData.volumn > 0 ? Number(cellData.volumn).toFixed(4) : ''}
                      </td>
                      <td className="border border-gray-400 p-1 text-right text-gray-900 font-medium">
                        {cellData && cellData.net_wage > 0 ? Number(cellData.net_wage).toLocaleString(undefined, {minimumFractionDigits: 2}) : ''}
                      </td>
                    </React.Fragment>
                  );
                })}
                
                {/* ยอดรวมของพนักงานคนนี้ */}
                <td className="border border-gray-400 p-1 text-right font-bold bg-blue-50/30 text-blue-900">
                  {Number(emp.total_volumn).toFixed(4)}
                </td>
                <td className="border border-gray-400 p-1 text-right font-bold bg-blue-100/50 text-blue-900">
                  {Number(emp.total_net_wage).toLocaleString(undefined, {minimumFractionDigits: 2})}
                </td>
              </tr>
            ))
          ) : (
             <tr>
               <td colSpan={expectedColumns.length * 2 + 4} className="border border-gray-400 p-8 text-center text-gray-500">
                 ไม่พบข้อมูลในช่วงเวลาที่เลือก
               </td>
             </tr>
          )}

          {/* บรรทัดสรุป Grand Total (แสดงเฉพาะหน้าสุดท้าย) */}
          {showFooter && grandTotal && data.length > 0 && (
            <tr className="bg-gray-300 font-bold text-gray-900 border-t-2 border-gray-600 text-[12px]">
              <td colSpan="2" className="border border-gray-400 p-2 text-center align-middle tracking-wider">รวมทั้งหมด</td>
              {expectedColumns.map((col, cIdx) => {
                const colKey = `${col.grade}_${col.is_special ? 'spc' : 'norm'}`;
                const gtCell = grandTotal[colKey];
                return (
                  <React.Fragment key={`gt-${cIdx}`}>
                    <td className="border border-gray-400 p-2 text-right">
                      {gtCell && gtCell.volumn > 0 ? Number(gtCell.volumn).toFixed(4) : ''}
                    </td>
                    <td className="border border-gray-400 p-2 text-right">
                      {gtCell && gtCell.net_wage > 0 ? Number(gtCell.net_wage).toLocaleString(undefined, {minimumFractionDigits: 2}) : ''}
                    </td>
                  </React.Fragment>
                );
              })}
              <td className="border border-gray-400 p-2 text-right bg-blue-200 text-blue-900">
                {Number(grandTotal.total_volumn).toFixed(4)}
              </td>
              <td className="border border-gray-400 p-2 text-right bg-blue-300 text-blue-900">
                {Number(grandTotal.total_net_wage).toLocaleString(undefined, {minimumFractionDigits: 2})}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  );
});

export default function WetWoodPerformanceReport() {
  const [filters, setFilters] = useState({
    branch_id: '',
    branch_name: '',
    start_date: new Date().toISOString().split('T')[0],
    end_date: new Date().toISOString().split('T')[0],
    store_code: '21/00 - 21/99'
  });

  const [reportData, setReportData] = useState([]);
  const [expectedColumns, setExpectedColumns] = useState([]);
  const [grandTotal, setGrandTotal] = useState(null);
  
  const [branches, setBranches] = useState([]);
  const [isLoading, setIsLoading] = useState(false);
  const [accessLevel, setAccessLevel] = useState(3);
  const [isExportingPDF, setIsExportingPDF] = useState(false);
  const [isExportingExcel, setIsExportingExcel] = useState(false);

  // Pagination
  const [currentPage, setCurrentPage] = useState(1);
  const itemsPerPage = 35; 

  useEffect(() => {
    let isMounted = true;
    const fetchInitialData = async () => {
      try {
        const currentPath = window.location.pathname;
        const res = await apiFetch(`/branches/allowed?menu=${currentPath}`);
        
        if (!isMounted) return;
        if (res?.success) {
          const validBranches = res.data.filter(b => b.id !== 0);
          setBranches(validBranches);
          setAccessLevel(res.access_level);
          
          if (res.access_level === 1) {
            setFilters(prev => ({ ...prev, branch_id: '', branch_name: '' }));
          } else if (validBranches.length > 0) {
            setFilters(prev => ({ 
              ...prev, 
              branch_id: validBranches[0].id,
              branch_name: validBranches[0].branch_name
            }));
          }
        }
      } catch (error) {
        console.error('Error fetching branches:', error);
      }
    };
    fetchInitialData();
    return () => { isMounted = false; };
  }, []);

  const handleFilterChange = (e) => setFilters({ ...filters, [e.target.name]: e.target.value });

  const handleDateChange = (date, name) => {
    if (date) setFilters({ ...filters, [name]: format(date, 'yyyy-MM-dd') });
  };

  const handleBranchChange = (e) => {
    const selectedIndex = e.target.options.selectedIndex;
    const branchName = e.target.options[selectedIndex].text;
    setFilters({ ...filters, branch_id: e.target.value, branch_name: branchName });
  };

  const handleSearch = async () => {
    if (!filters.branch_id || !filters.start_date || !filters.end_date) {
      return Swal.fire('แจ้งเตือน', 'กรุณาระบุสาขาและช่วงวันที่', 'warning');
    }
    
    setIsLoading(true);
    try {
      const queryParams = new URLSearchParams({
        branch_id: filters.branch_id,
        start_date: filters.start_date,
        end_date: filters.end_date,
        store_code: filters.store_code
      }).toString();

      const res = await apiFetch(`/reports/wet-wood-perf?${queryParams}`);
      if (res?.success) {
        if (res.data.length === 0) {
          Swal.fire('แจ้งเตือน', 'ไม่พบข้อมูลในช่วงเวลาที่เลือก', 'info');
          setReportData([]);
        } else {
          setReportData(res.data);
          setExpectedColumns(res.expectedColumns || []);
          setGrandTotal(res.grandTotal);
          setCurrentPage(1);
        }
      }
    } catch (error) {
      Swal.fire('ข้อผิดพลาด', 'ดึงข้อมูลรายงานล้มเหลว', 'error');
    } finally {
      setIsLoading(false);
    }
  };

  const handleExportPDF = async (isPreview = false) => {
    setIsExportingPDF(true);
    Swal.fire({
      title: 'กำลังสร้างไฟล์ PDF...',
      html: 'กรุณารอสักครู่ ระบบกำลังประมวลผลข้อมูล',
      allowOutsideClick: false,
      didOpen: () => Swal.showLoading()
    });

    try {
      const q = new URLSearchParams({
        start_date: filters.start_date,
        end_date: filters.end_date,
        branch_id: filters.branch_id,
        store_code: filters.store_code,
        branch_name: filters.branch_name
      }).toString();

      const apiUrl = API_URL;
      
      const res = await fetch(`${apiUrl}/reports/wet-wood-perf/pdf?${q}`, {
        credentials: 'include'
      });

      if (!res.ok) throw new Error('Failed to generate PDF');
      
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      
      Swal.close();

      if (isPreview) {
        window.open(url, '_blank');
      } else {
        const a = document.createElement('a');
        a.href = url;
        a.download = `Wet_Wood_Perf_${filters.start_date}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
      }
    } catch (error) {
      console.error(error);
      Swal.fire('ข้อผิดพลาด', 'ไม่สามารถสร้างไฟล์ PDF ได้', 'error');
    } finally {
      setIsExportingPDF(false);
    }
  };

  const handleExportExcel = async () => {
    setIsExportingExcel(true);
    Swal.fire({
      title: 'กำลังสร้างไฟล์ Excel...',
      html: 'กรุณารอสักครู่ ระบบกำลังประมวลผลข้อมูล',
      allowOutsideClick: false,
      didOpen: () => Swal.showLoading()
    });

    try {
      const q = new URLSearchParams({
        start_date: filters.start_date,
        end_date: filters.end_date,
        branch_id: filters.branch_id,
        store_code: filters.store_code,
        branch_name: filters.branch_name
      }).toString();

      const apiUrl = API_URL;
      
      const res = await fetch(`${apiUrl}/reports/wet-wood-perf/excel?${q}`, {
        credentials: 'include'
      });

      if (!res.ok) throw new Error('Failed to generate Excel');
      
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);

      Swal.close();

      const a = document.createElement('a');
      a.href = url;
      a.download = `Wet_Wood_Perf_${filters.start_date}.xlsx`;
      document.body.appendChild(a);
      a.click();
      a.remove();
    } catch (error) {
      console.error(error);
      Swal.fire('ข้อผิดพลาด', 'ไม่สามารถสร้างไฟล์ Excel ได้', 'error');
    } finally {
      setIsExportingExcel(false);
    }
  };

  // การคำนวณ Pagination
  const totalPages = Math.ceil(reportData.length / itemsPerPage) || 1;
  const indexOfLastItem = currentPage * itemsPerPage;
  const indexOfFirstItem = indexOfLastItem - itemsPerPage;
  const currentRows = reportData.slice(indexOfFirstItem, indexOfLastItem);

  return (
    <div className="p-4 md:p-6 mx-auto min-h-screen bg-gray-50">
      {/* ─── กล่องค้นหา ─── */}
      <div className="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6 print:hidden">
        <h2 className="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
          <i className="fas fa-users-cog text-teal-600"></i> รายงานสรุปค่าแรงจัดเรียงไม้เปียก แยกรายคน
        </h2>
        
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div className="flex flex-col">
            <label className="text-xs font-semibold mb-1 text-gray-700">สาขา <span className="text-red-500">*</span></label>
            <select
              name="branch_id"
              value={filters.branch_id}
              onChange={handleBranchChange}
              disabled={isLoading || (accessLevel !== 1 && branches.length <= 1)}
              className="w-full border rounded-md p-2 text-sm outline-none focus:border-teal-500 bg-gray-50 disabled:bg-gray-200 disabled:text-gray-500"
            >
              <option value="" disabled>-- เลือกสาขา --</option>
              {branches.map(b => <option key={b.id} value={b.id}>{b.branch_name}</option>)}
            </select>
          </div>
          
          <div className="flex flex-col">
            <label className="text-xs font-semibold mb-1 text-gray-700">วันที่เริ่มต้น <span className="text-red-500">*</span></label>
            <DatePicker
              selected={filters.start_date ? parseISO(filters.start_date) : null}
              onChange={(date) => handleDateChange(date, 'start_date')}
              dateFormat="dd/MM/yyyy" locale={th}
              className="w-full border rounded-md p-2 text-sm outline-none bg-gray-50"
              wrapperClassName="w-full"
            />
          </div>
          
          <div className="flex flex-col">
            <label className="text-xs font-semibold mb-1 text-gray-700">วันที่สิ้นสุด <span className="text-red-500">*</span></label>
            <DatePicker
              selected={filters.end_date ? parseISO(filters.end_date) : null}
              onChange={(date) => handleDateChange(date, 'end_date')}
              dateFormat="dd/MM/yyyy" locale={th}
              className="w-full border rounded-md p-2 text-sm outline-none bg-gray-50"
              wrapperClassName="w-full"
            />
          </div>
          
          <div className="flex flex-col">
            <label className="text-xs font-semibold mb-1 text-gray-700">ช่วงสโตร์ (ไม้เปียก)</label>
            <input 
              type="text" 
              name="store_code" 
              value={filters.store_code} 
              onChange={handleFilterChange} 
              placeholder="เช่น 21/00 - 21/99"
              className="w-full border rounded-md p-2 text-sm outline-none bg-gray-50 focus:border-teal-500"
            />
          </div>
        </div>

        <div className="mt-6 flex justify-between items-center">
          <button 
            onClick={handleSearch} 
            disabled={isLoading} 
            className="bg-teal-600 text-white px-8 py-2 rounded-md text-sm font-semibold hover:bg-teal-700 shadow-sm flex items-center justify-center min-w-[120px]"
          >
            {isLoading ? <><i className="fas fa-spinner fa-spin mr-2"></i>กำลังโหลด...</> : <><i className="fas fa-search mr-2"></i>ดึงข้อมูล</>}
          </button>
          
          {reportData.length > 0 && (
            <div className="flex gap-2">
              <button onClick={() => handleExportPDF(true)} disabled={isExportingPDF} className="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm font-semibold shadow-sm flex items-center gap-2">
                <i className="fas fa-search-plus"></i> {isExportingPDF ? 'กำลังสร้าง...' : 'ตัวอย่าง PDF'}
              </button>
              <button onClick={() => handleExportPDF(false)} disabled={isExportingPDF} className="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-semibold shadow-sm flex items-center gap-2">
                <i className="fas fa-file-pdf"></i> โหลด PDF
              </button>
              <button onClick={handleExportExcel} disabled={isExportingExcel} className="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-semibold shadow-sm flex items-center gap-2">
                <i className="fas fa-file-excel"></i> ส่งออก Excel
              </button>
            </div>
          )}
        </div>
      </div>

      {/* ─── ตารางแสดงผล ─── */}
      {reportData.length > 0 && (
        <div className="bg-white rounded-lg shadow-sm border border-gray-200 pb-6 print:border-none print:shadow-none min-h-[900px] flex flex-col justify-between">
          
          <div>
            {/* หัวกระดาษ (Header) */}
            <div className="text-center mb-6 pt-6">
              <h1 className="text-lg font-bold text-gray-800">บริษัท วู้ดเวอร์ค จำกัด ({filters.branch_name})</h1>
              <h2 className="text-md font-semibold text-gray-700 mt-1">รายงานสรุปค่าแรงเรียงไม้เปียก แยกรายคน</h2>
              <p className="text-sm text-gray-600 mt-1">
                ตั้งแต่วันที่ {format(parseISO(filters.start_date), 'dd/MM/yyyy')} ถึง {format(parseISO(filters.end_date), 'dd/MM/yyyy')}
              </p>
              <p className="text-sm text-gray-600 mt-1">รหัสสโตร์: <span className="font-semibold">{filters.store_code || '21/00 - 21/99'}</span></p>
            </div>

            <div className="px-4">
              <ReportTable 
                data={currentRows} 
                grandTotal={grandTotal} 
                expectedColumns={expectedColumns}
                showFooter={currentPage === totalPages || totalPages === 0} 
              />
            </div>
          </div>

          {/* ลายเซ็นต์ท้ายรายงาน (แสดงเฉพาะหน้าสุดท้าย) */}
          {(currentPage === totalPages || totalPages === 0) && (
            <div className="mt-12 px-10 grid grid-cols-3 gap-8 text-center text-sm mb-4 print:mt-24">
              <div>
                <p>...........................................................</p>
                <p className="mt-2 text-gray-600">ผู้รายงาน</p>
              </div>
              <div>
                <p>...........................................................</p>
                <p className="mt-2 text-gray-600">ฝ่ายข้อมูลโรงงาน</p>
              </div>
              <div>
                <p>...........................................................</p>
                <p className="mt-2 text-gray-600">ผู้จัดการโรงงาน</p>
              </div>
            </div>
          )}

          {/* ระบบแบ่งหน้า (Pagination) */}
          {totalPages > 1 && (
            <div className="flex items-center justify-between px-4 py-3 bg-white border-t border-gray-200 mt-4 mx-4 print:hidden">
              <div className="flex gap-2">
                <button onClick={() => setCurrentPage(1)} disabled={currentPage === 1} className="px-3 py-2 text-sm border hover:bg-gray-50 disabled:bg-gray-100 rounded-md">« หน้าแรก</button>
                <button onClick={() => setCurrentPage(prev => Math.max(prev - 1, 1))} disabled={currentPage === 1} className="px-3 py-2 text-sm border hover:bg-gray-50 disabled:bg-gray-100 rounded-md">‹ ก่อนหน้า</button>
              </div>

              <div className="flex items-center gap-2">
                <span className="text-sm">หน้า</span>
                <select value={currentPage} onChange={(e) => setCurrentPage(Number(e.target.value))} className="border py-1 px-2 text-sm text-teal-700 font-bold rounded-md outline-none focus:ring-1 focus:ring-teal-500">
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map(page => (
                    <option key={page} value={page}>{page}</option>
                  ))}
                </select>
                <span className="text-sm">จาก {totalPages}</span>
              </div>

              <div className="flex gap-2">
                <button onClick={() => setCurrentPage(prev => Math.min(prev + 1, totalPages))} disabled={currentPage === totalPages} className="px-3 py-2 text-sm border hover:bg-gray-50 disabled:bg-gray-100 rounded-md">ถัดไป ›</button>
                <button onClick={() => setCurrentPage(totalPages)} disabled={currentPage === totalPages} className="px-3 py-2 text-sm border hover:bg-gray-50 disabled:bg-gray-100 rounded-md">หน้าสุดท้าย »</button>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/pages/WoodPriceManager.jsx">
import { useState, useEffect, useRef } from 'react';
import Swal from 'sweetalert2';
import apiFetch, { API_URL } from '../services/apiFetch';
import { getUser } from '../utils/session';

export default function WoodPriceManager() {
  // ─── State: ข้อมูลและสิทธิ์ ───
  const [branches, setBranches] = useState([]);
  const [selectedBranch, setSelectedBranch] = useState('');
  const [accessLevel, setAccessLevel] = useState(3);
  const [isAdmin, setIsAdmin] = useState(false);
  const [currentUser, setCurrentUser] = useState(null);

  // ─── State: กรองข้อมูล (Filters) ───
  const [filters, setFilters] = useState({
    thick: '',
    width: '',
    length: '',
    mil: '',
    wood_code: ''
  });

  // ─── State: ตารางสินค้าและการแก้ไข ───
  const [products, setProducts] = useState([]);
  const [isLoading, setIsLoading] = useState(false);
  
  // เก็บค่าที่ถูกแก้ไข: { [id]: newPrice }
  const [editedPrices, setEditedPrices] = useState({});
  const fileInputRef = useRef(null);

  // ─── โหลดข้อมูลเริ่มต้น ───
  useEffect(() => {
    let isMounted = true; 

    const user = getUser();
    if (user) {
      setCurrentUser(user);
      setIsAdmin(user.group_id === 1);
    }

    const fetchAllowedBranches = async () => {
      try {
        const currentPath = window.location.pathname;
        const data = await apiFetch(`/branches/allowed?menu=${currentPath}`);
        
        if (!isMounted) return;

        if (data?.success) {
          setBranches(data.data);
          setAccessLevel(data.access_level);
          
          if (data.access_level === 1) {
            setSelectedBranch(0); 
          } else if (data.data.length > 0) {
            setSelectedBranch(data.data[0].id);
          }
        }
      } catch (error) {
        console.error('Fetch branches error:', error);
      }
    };

    fetchAllowedBranches();

    return () => {
      isMounted = false; 
    };
  }, []);

  // ดึงข้อมูลสินค้าตาม Filter (เรียกเมื่อ Filter เปลี่ยน หรือ สาขาเปลี่ยน)
  const fetchProducts = async () => {
    if (selectedBranch === '' || selectedBranch === 0) return; 

    setIsLoading(true);
    try {
      const queryParams = new URLSearchParams({
        branch_id: selectedBranch,
        type_id: 1, 
        ...filters
      }).toString();

      const data = await apiFetch(`/master/wood-prices?${queryParams}`);
      if (data?.success) {
        setProducts(data.data);
        setEditedPrices({}); 
      }else {
        Swal.fire({
          icon: 'warning',
          title: 'ถูกปฏิเสธ',
          text: data?.message || 'ไม่สามารถดึงข้อมูลได้',
          confirmButtonColor: '#3b82f6',
          // เพิ่ม style รองรับ dark mode
          background: document.documentElement.classList.contains('dark') ? '#1f2937' : '#ffffff',
          color: document.documentElement.classList.contains('dark') ? '#f3f4f6' : '#111827'
        });
        setProducts([]); 
      }
    } catch (error) {
      console.error('Fetch products error:', error);
      Swal.fire('ข้อผิดพลาด', 'ไม่สามารถดึงข้อมูลสินค้าได้', 'error');
    } finally {
      setIsLoading(false);
    }
  };

  // ดึงข้อมูลอัตโนมัติเมื่อกด Enter หรือเปลี่ยนสาขา
  useEffect(() => {
    if (selectedBranch !== '' && selectedBranch !== 0) {
      fetchProducts();
    }
  }, [selectedBranch]);

  // ─── Handlers ───
  const handleFilterChange = (e) => {
    setFilters({ ...filters, [e.target.name]: e.target.value });
  };

  const handlePriceChange = (id, value) => {
    setEditedPrices(prev => ({
      ...prev,
      [id]: value
    }));
  };

  const handleSavePrices = async () => {
    const editCount = Object.keys(editedPrices).length;
    if (editCount === 0) return;

    const payload = Object.entries(editedPrices).map(([id, price]) => ({
      id: Number(id),
      unit_price: Number(price)
    }));

    try {
      const data = await apiFetch('/master/wood-prices/bulk-update', {
        method: 'PUT',
        body: JSON.stringify({ prices: payload })
      });

      if (data?.success) {
        Swal.fire({ 
          icon: 'success', 
          title: 'บันทึกสำเร็จ', 
          text: `อัปเดตราคา ${editCount} รายการแล้ว`, 
          timer: 2000, 
          showConfirmButton: false,
          background: document.documentElement.classList.contains('dark') ? '#1f2937' : '#ffffff',
          color: document.documentElement.classList.contains('dark') ? '#f3f4f6' : '#111827'
        });
        fetchProducts(); 
      } else {
        Swal.fire('ข้อผิดพลาด', data?.message || 'ไม่สามารถบันทึกได้', 'error');
      }
    } catch (error) {
      Swal.fire('ระบบขัดข้อง', 'เชื่อมต่อเซิร์ฟเวอร์ไม่ได้', 'error');
    }
  };

  const handleExportExcel = () => {
    window.open(`${API_URL}/master/wood-prices/export?branch_id=${selectedBranch}&type_id=1&paramExport=true`, '_blank');
  };

  const handleImportExcel = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('file', file);
    formData.append('branch_id', selectedBranch);

    try {
      Swal.fire({ 
        title: 'กำลังนำเข้าข้อมูล...', 
        allowOutsideClick: false, 
        didOpen: () => Swal.showLoading(),
        background: document.documentElement.classList.contains('dark') ? '#1f2937' : '#ffffff',
        color: document.documentElement.classList.contains('dark') ? '#f3f4f6' : '#111827'
      });
      
      // apiFetch จัดการ cookie + CSRF header + FormData ให้อัตโนมัติ
      const data = await apiFetch('/master/wood-prices/import', {
        method: 'POST',
        body: formData
      });
      if (!data) return;

      if (data.success) {
        Swal.fire({ 
          icon: 'success', 
          title: 'นำเข้าสำเร็จ!', 
          text: `อัปเดตราคา ${data.updated_count} รายการ`, 
          timer: 2500,
          background: document.documentElement.classList.contains('dark') ? '#1f2937' : '#ffffff',
          color: document.documentElement.classList.contains('dark') ? '#f3f4f6' : '#111827'
        });
        fetchProducts();
      } else {
        Swal.fire('เกิดข้อผิดพลาด', data.message, 'error');
      }
    } catch (error) {
      Swal.fire('ระบบขัดข้อง', 'เชื่อมต่อเซิร์ฟเวอร์ไม่ได้', 'error');
    } finally {
      e.target.value = null; 
    }
  };

  const allowedBranches = isAdmin ? branches : branches.filter(b => b.id === currentUser?.branch_id);

  return (
    <div className="p-4 md:p-6 max-w-7xl mx-auto flex flex-col gap-6 h-full transition-colors duration-300">
      
      {/* Header & Controls */}
      <div className="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 transition-colors duration-300">
        <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
          <div>
            <h2 className="text-xl font-bold text-gray-800 dark:text-gray-100">
              <i className="fas fa-tags text-blue-600 dark:text-blue-400 mr-2"></i> จัดการราคาขายไม้เลื่อย
            </h2>
            <p className="text-sm text-gray-500 dark:text-gray-400 mt-1">
              กำหนดราคาสินค้า (Unit Price) แยกตามสาขา สำหรับไม้เลื่อยเท่านั้น
            </p>
          </div>
          
          <div className="flex flex-wrap items-center gap-3">
            <button onClick={handleExportExcel} disabled={selectedBranch === 0 || selectedBranch === ''} 
              className="px-4 py-2 bg-green-50 text-green-700 border border-green-200 hover:bg-green-100 dark:bg-green-900/30 dark:text-green-400 dark:border-green-800 dark:hover:bg-green-900/50 rounded-lg text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
              <i className="fas fa-file-excel mr-2"></i> โหลด Template
            </button>
            <input type="file" ref={fileInputRef} onChange={handleImportExcel} accept=".xlsx, .xls" className="hidden" />
            <button onClick={() => fileInputRef.current?.click()} disabled={selectedBranch === 0 || selectedBranch === ''} 
              className="px-4 py-2 bg-green-600 text-white hover:bg-green-700 dark:hover:bg-green-500 rounded-lg text-sm font-medium shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
              <i className="fas fa-upload mr-2"></i> นำเข้า Excel
            </button>
          </div>
        </div>

        {/* สาขา & Filter */}
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-7 gap-4 items-end">
          <div className="md:col-span-2">
            <label className="block text-xs font-semibold text-gray-600 dark:text-gray-300 mb-1">สาขาที่จัดการ</label>
            <select
              value={selectedBranch}
              onChange={(e) => setSelectedBranch(e.target.value)}
              className="w-full bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 text-sm rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
            >
              <option value="" disabled>-- กรุณาเลือกสาขา --</option>
              {allowedBranches.map(b => (
                <option key={b.id} value={b.id} className="bg-white dark:bg-gray-800">{b.branch_code} - {b.branch_name}</option>
              ))}
            </select>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">มิล</label>
            <input type="text" name="mil" value={filters.mil} onChange={handleFilterChange} 
              className="w-full bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 text-sm rounded-lg p-2.5 outline-none focus:ring-1 focus:ring-blue-500 placeholder-gray-400 dark:placeholder-gray-500 transition-colors" placeholder="มิล..." />
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">หนา</label>
            <input type="text" name="thick" value={filters.thick} onChange={handleFilterChange} 
              className="w-full bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 text-sm rounded-lg p-2.5 outline-none focus:ring-1 focus:ring-blue-500 placeholder-gray-400 dark:placeholder-gray-500 transition-colors" placeholder="หนา..." />
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">กว้าง</label>
            <input type="text" name="width" value={filters.width} onChange={handleFilterChange} 
              className="w-full bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 text-sm rounded-lg p-2.5 outline-none focus:ring-1 focus:ring-blue-500 placeholder-gray-400 dark:placeholder-gray-500 transition-colors" placeholder="กว้าง..." />
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">ยาว</label>
            <input type="text" name="length" value={filters.length} onChange={handleFilterChange} 
              className="w-full bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 text-sm rounded-lg p-2.5 outline-none focus:ring-1 focus:ring-blue-500 placeholder-gray-400 dark:placeholder-gray-500 transition-colors" placeholder="ยาว..." />
          </div>
          <button onClick={fetchProducts} disabled={selectedBranch === '' || selectedBranch === 0 || isLoading} 
            className="w-full px-4 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            {isLoading ? <i className="fas fa-spinner fa-spin"></i> : <><i className="fas fa-search mr-2"></i> ค้นหา</>}
          </button>
        </div>
      </div>

      {/* ตารางข้อมูล */}
      <div className="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 flex-1 flex flex-col overflow-hidden transition-colors duration-300">
        <div className="p-4 border-b border-gray-200 dark:border-gray-700 flex flex-wrap justify-between items-center gap-3 bg-gray-50 dark:bg-gray-800/80 transition-colors duration-300">
          <span className="text-sm font-semibold text-gray-700 dark:text-gray-300">
            รายการสินค้า {products.length > 0 && <span className="text-blue-600 dark:text-blue-400 ml-1">({products.length} รายการ)</span>}
          </span>
          <button 
            onClick={handleSavePrices} 
            disabled={Object.keys(editedPrices).length === 0}
            className="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm flex items-center gap-2"
          >
            <i className="fas fa-save"></i> บันทึกราคาที่แก้ไข 
            {Object.keys(editedPrices).length > 0 && <span className="bg-white text-blue-600 text-xs font-bold px-2 py-0.5 rounded-full ml-1">{Object.keys(editedPrices).length}</span>}
          </button>
        </div>
        
        <div className="overflow-auto flex-1 custom-scrollbar">
          <table className="w-full text-left border-collapse">
            <thead className="bg-gray-100 dark:bg-gray-900 text-gray-600 dark:text-gray-400 text-xs uppercase sticky top-0 z-10 shadow-[0_1px_2px_rgba(0,0,0,0.05)] dark:shadow-[0_1px_2px_rgba(0,0,0,0.5)] transition-colors duration-300">
              <tr>
                <th className="p-3 font-semibold w-32 border-b dark:border-gray-700">บาร์โค้ด</th>
                <th className="p-3 font-semibold border-b dark:border-gray-700">ขนาด (หนา x กว้าง x ยาว)</th>
                <th className="p-3 font-semibold text-center w-24 border-b dark:border-gray-700">มิล</th>
                <th className="p-3 font-semibold text-right w-32 border-b dark:border-gray-700">ราคาเดิม (฿)</th>
                <th className="p-3 font-semibold w-40 border-b dark:border-gray-700">ราคาใหม่ (฿)</th>
              </tr>
            </thead>
            <tbody className="text-sm divide-y divide-gray-200">
              {isLoading ? (
                <tr>
                  <td colSpan="5" className="p-12 text-center text-gray-500">
                    <i className="fas fa-spinner fa-spin text-2xl mb-3 block text-blue-600"></i> 
                    กำลังโหลดข้อมูล...
                  </td>
                </tr>
              ) : products.length === 0 ? (
                <tr>
                  <td colSpan="5" className="p-12 text-center text-gray-500 font-medium">
                    กรุณาเลือกสาขา และกดค้นหาเพื่อแสดงข้อมูล
                  </td>
                </tr>
              ) : (
                products.map((item) => {
                  const isEdited = editedPrices[item.id] !== undefined;
                  return (
                    <tr 
                      key={item.id} 
                      className={`transition-colors duration-150 ${
                        isEdited 
                          ? 'bg-blue-50/80 hover:bg-blue-100/60' 
                          : 'bg-white hover:bg-gray-100/80'
                      }`}
                    >
                      {/* บาร์โค้ด / รหัสไม้ */}
                      <td className="p-3 font-mono font-medium text-gray-900 whitespace-nowrap">
                        {item.wood_code || '-'}
                      </td>

                      {/* ขนาด */}
                      <td className="p-3 font-semibold text-gray-900 whitespace-nowrap">
                        {item.thick} x {item.width} x {item.length}
                      </td>

                      {/* มิล */}
                      <td className="p-3 text-center font-medium text-gray-800">
                        {item.mil}
                      </td>

                      {/* ราคาเดิม */}
                      <td className="p-3 text-right font-bold text-gray-900">
                        {Number(item.unit_price).toFixed(2)}
                      </td>

                      {/* ราคาใหม่ */}
                      <td className="p-3">
                        <div className="relative">
                          <span className={`absolute inset-y-0 left-0 flex items-center pl-3 text-sm font-bold ${
                            isEdited ? 'text-blue-600' : 'text-gray-500'
                          }`}>
                            ฿
                          </span>
                          <input
                            type="number"
                            step="0.01"
                            value={editedPrices[item.id] !== undefined ? editedPrices[item.id] : ''}
                            placeholder={Number(item.unit_price).toFixed(2)}
                            onChange={(e) => handlePriceChange(item.id, e.target.value)}
                            className={`w-full pl-8 pr-3 py-1.5 text-sm font-semibold rounded-md outline-none border transition-all duration-200 ${
                              isEdited 
                                ? 'bg-white border-blue-500 text-blue-900 focus:ring-2 focus:ring-blue-500/20 shadow-sm' 
                                : 'bg-gray-50/80 border-gray-300 text-gray-900 placeholder-gray-400 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 hover:border-gray-400'
                            }`}
                          />
                        </div>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
