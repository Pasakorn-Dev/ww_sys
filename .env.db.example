# .env.db — ใช้กับ container postgres เท่านั้น  ห้าม commit
# บัญชีแอดมินของ Postgres (ใช้ตอน init/restore/สำรองข้อมูล — backend ไม่ใช้บัญชีนี้)
POSTGRES_USER=postgres
# สร้าง:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_admin_hex
POSTGRES_DB=ww_sys
# รหัสผ่านของ app_user (สิทธิ์จำกัด) — database-init/1-init-user.sh อ่านค่านี้ตอนสร้าง user
# สร้าง:  openssl rand -hex 24   และ DB_PASSWORD ใน .env ต้องเป็นค่าเดียวกัน
APP_DB_PASSWORD=CHANGE_ME_app_hex

