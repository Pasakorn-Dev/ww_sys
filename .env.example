# .env (root โปรเจกต์) — ใช้กับ backend  ห้าม commit
NODE_ENV=production
PORT=3000
# สร้าง:  openssl rand -hex 48
JWT_SECRET=CHANGE_ME
DB_HOST=postgres-db
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=ค่าเดียวกับ POSTGRES_PASSWORD
DB_NAME=ww_sys

# ===== เฟส 1: วงแลน (HTTP) =====
# พิมพ์ในเบราว์เซอร์อย่างไร ต้องเขียนตรงกันทุกตัวอักษร (http, ไม่มี / ท้าย)
CORS_ORIGINS=http://192.168.0.50
# HTTP ไม่มี HTTPS → cookie แบบ Secure จะไม่ถูกเก็บ จึงต้องปิดชั่วคราว
COOKIE_SECURE=false
TRUST_PROXY=1

# ===== เฟส 2: เปิดออกอินเทอร์เน็ต → แก้เป็น =====
# CORS_ORIGINS=https://app.yourdomain.com
# (ลบบรรทัด COOKIE_SECURE=false ออก)

PDF_CONCURRENCY=2
# PUPPETEER_NO_SANDBOX=true

MYSQL_HOST_1=192.168.0.x
MYSQL_USER_1=root
MYSQL_PASSWORD_1=xxx
MYSQL_DB_1=woodworkbarcode
