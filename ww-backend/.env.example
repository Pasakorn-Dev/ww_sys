MYSQL_USER_1=root
MYSQL_PASSWORD_1=xxx
MYSQL_PORT_1=3306
MYSQL_DB_1=woodworkbarcode

# สาขา 12 (อ้างอิงตามชื่อตัวแปรในรูป)
