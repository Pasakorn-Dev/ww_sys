# ==========================================
# 1. ตั้งค่าสำหรับสร้างตู้ PostgreSQL (Docker ใช้ตอนสร้างตู้)
# ==========================================
POSTGRES_USER=app_user
POSTGRES_PASSWORD=xxx
POSTGRES_DB=ww_system

# ==========================================
# 2. ตั้งค่า Backend Node.js
# ==========================================
PORT=3000
JWT_SECRET=ww_your_super_secret_key_ppos_2026..

# ⚙️ Database PostgreSQL (ระบบใหม่ - ศูนย์กลาง)
DB_USER=app_user
DB_PASSWORD=xxx
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=ww_system

# ==========================================
# 3. Database MySQL 5.6 (ระบบเก่า - แยกตามสาขา)
