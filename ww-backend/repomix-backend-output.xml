        ,(price_normal_ab / NULLIF(vol_normal_ab, 0)) AS normal_ab
        ,(price_special_ab / NULLIF(vol_special_ab, 0)) AS special_ab
        ,(price_ab / NULLIF(vol_ab, 0)) AS avg_ab

