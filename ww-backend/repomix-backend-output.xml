            volRow.getCell(i).numFmt = '#,##0.00';
            pctRow.getCell(i).numFmt = '0.00%';
            pctRow.getCell(i).font = { color: { argb: 'FF808080' } };
          }
          volRow.getCell(10).font = { bold: true };
          pctRow.getCell(10).font = { bold: true, color: { argb: 'FF808080' } };
