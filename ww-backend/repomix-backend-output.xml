        gtPcts[key] = gt.total_volumn > 0 ? (gt[key] / gt.total_volumn) * 100 : 0;
      }
    }
    gtPcts.total_volumn = gt.total_volumn > 0 ? 100 : 0;

    return { formattedData: Object.values(monthlyGroups), grandTotal: { vols: gt, pcts: gtPcts } };
  },

