                    ]);

                    const chunkEvalSize = 4000;
                    for (let i = 0; i < evalSizeValues.length; i += chunkEvalSize) {
                        const chunk = evalSizeValues.slice(i, i + chunkEvalSize);
                        
                        const upsertEvalSizeQuery = format(`
                            INSERT INTO master_log_wood_eval_sizes (
