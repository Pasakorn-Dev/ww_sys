    };

    const monthlyGroups = {};

    rows.forEach(row => {
      const d = new Date(row.produce_date);
      const monthYear = `${d.getMonth() + 1}/${d.getFullYear()}`;

      if (!monthlyGroups[monthYear]) {
        monthlyGroups[monthYear] = {
          month_label: monthYear,
          days: [],
          monthly_total: {
