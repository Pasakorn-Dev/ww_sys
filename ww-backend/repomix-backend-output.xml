<file path="src/controllers/reportController.js">
const pool = require('../config/db');
const ReportModel = require('../models/reportModel');
// const puppeteer = require('puppeteer'); // หรือใช้ library ทำ PDF ที่ระบบคุณมีอยู่แล้ว
// const { default: puppeteer } = await import('puppeteer');
const ExcelJS = require('exceljs'); // <- ต้องมีบรรทัดนี้
const fs = require('fs');      
const path = require('path');  

// ─────────────────────────────────────────────────────────────
// 💡 ระบบ PDF กลาง: Browser ตัวเดียว + คิวจำกัดงานพร้อมกัน + ปิดแท็บเสมอ
// ─────────────────────────────────────────────────────────────

// escape ข้อความก่อนฝังลง HTML (กัน HTML injection จาก req.query)
const esc = (v) =>
  String(v ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

// cache ฟอนต์ไว้ในหน่วยความจำ (ไม่อ่านไฟล์ + encode ใหม่ทุก request)
const fontCache = new Map();
const readFontCached = (fontPath) => {
  if (!fontCache.has(fontPath)) {
    fontCache.set(fontPath, fs.readFileSync(fontPath).toString('base64'));
  }
  return fontCache.get(fontPath);
};

let browserPromise = null;

const launchBrowser = async () => {
  const puppeteer = (await import('puppeteer')).default;

  const args = ['--disable-dev-shm-usage']; // กัน /dev/shm เต็มใน Docker/Linux
  if (process.platform !== 'win32') args.push('--disable-gpu');

  // ⚠️ เปิดเฉพาะเมื่อจำเป็นจริง ๆ (เช่น Docker ที่ยังแก้ user namespace ไม่ได้)
  // ตั้งค่า PUPPETEER_NO_SANDBOX=true ใน .env ของเครื่องนั้นเท่านั้น
  const noSandbox = process.env.PUPPETEER_NO_SANDBOX === 'true';
  if (noSandbox) args.push('--no-sandbox', '--disable-setuid-sandbox');

  console.log(`🚀 Starting new Chrome browser instance... (sandbox: ${noSandbox ? 'OFF' : 'ON'})`);

  const browser = await puppeteer.launch({
    executablePath: process.env.PUPPETEER_EXECUTABLE_PATH || undefined,
    headless: true, // ถ้าใช้ Puppeteer v22+ เปลี่ยนเป็น true ได้
    args,
  });

  // ถ้า Chrome แครช/ถูกปิด ให้เคลียร์ เพื่อให้ request ถัดไปเปิดใหม่
  browser.on('disconnected', () => {
    console.warn('⚠️ Browser disconnected');
    browserPromise = null;
  });

  return browser;
};

const getBrowser = async () => {
  if (browserPromise) {
    try {
      const browser = await browserPromise;
      const isConnected =
        typeof browser.isConnected === 'function' ? browser.isConnected() : browser.connected;
      if (isConnected) return browser;
    } catch (_) {
      // launch ครั้งก่อนล้มเหลว → ลองใหม่ด้านล่าง
    }
    browserPromise = null;
  }

  // กำหนด promise แบบ synchronous เพื่อให้ request ที่เข้ามาพร้อมกันใช้ instance เดียวกัน
  browserPromise = launchBrowser();
  try {
    return await browserPromise;
  } catch (error) {
    console.error('❌ Browser Launch Error:', error);
    browserPromise = null;
    throw error;
  }
};

// คิวจำกัดจำนวนงาน PDF พร้อมกัน (ปรับได้ด้วย PDF_CONCURRENCY ใน .env)
const PDF_CONCURRENCY = Number(process.env.PDF_CONCURRENCY) || 2;
let pdfActive = 0;
const pdfWaiters = [];
const acquirePdfSlot = () =>
  new Promise((resolve) => {
    if (pdfActive < PDF_CONCURRENCY) {
      pdfActive++;
      resolve();
    } else {
      pdfWaiters.push(resolve);
    }
  });
const releasePdfSlot = () => {
  const next = pdfWaiters.shift();
  if (next) next(); // ส่งต่อ slot ให้คิวถัดไป (pdfActive คงเดิม)
  else pdfActive--;
};

// แปลง HTML → PDF Buffer (ปลอดภัย: ปิด JS, บล็อก request ภายนอก, ปิดแท็บเสมอ)
const renderPdf = async (html, pdfOptions = {}) => {
  await acquirePdfSlot();
  let page;
  try {
    const browser = await getBrowser();
    page = await browser.newPage();

    // รายงานเป็น HTML ล้วน ไม่ต้องรัน script
    await page.setJavaScriptEnabled(false);

    // อนุญาตเฉพาะ data: (ฟอนต์ base64) — ทุกอย่างอื่นถูกบล็อก (กัน SSRF / โหลดของภายนอกค้าง)
    await page.setRequestInterception(true);
    page.on('request', (req) => {
      const url = req.url();
      if (url.startsWith('data:') || url === 'about:blank') return req.continue();
      return req.abort();
    });

    // HTML ไม่มี resource ภายนอก จึงไม่ต้องรอ networkidle0
    await page.setContent(html, { waitUntil: 'load', timeout: 60000 });

    const pdf = await page.pdf({ ...pdfOptions, timeout: 120000 });
    return Buffer.from(pdf); // Puppeteer v22+ คืน Uint8Array → แปลงเป็น Buffer ให้ res.send ใช้ได้
  } finally {
    if (page) await page.close().catch(() => {});
    releasePdfSlot();
  }
};

// 💡 1. ปรับฟังก์ชัน Helper ให้รับ parameter 'grade' เข้ามาและตั้งเงื่อนไข
// ประกาศฟังก์ชันแบบ Async รับค่า วันเริ่มต้น, วันสิ้นสุด, รหัสสาขา และ เกรดไม้ (ถ้าไม่ส่งมาจะใช้ 'AB' เป็นค่าปริยาย)
const fetchWoodTypeAbData = async (start_date, end_date, branch_id, grade = 'AB') => {
  
  // กำหนดเงื่อนไขตั้งต้นสำหรับเกรดใน SQL (ถ้าไม่เข้าเงื่อนไขอะไรเลย จะบังคับดึง AB)
  let gradeCondition = "mws.grade = 'AB'";
  // กำหนดตัวแปรที่ใช้เตรียมส่งเข้าไปใน SQL (ป้องกัน SQL Injection) ตามลำดับ $1, $2, $3
  const params = [start_date, end_date, branch_id];

  // ตรวจสอบเงื่อนไขเกรด: ถ้าส่งเกรดมาและไม่ใช่ 'ALL'
  if (grade && grade !== 'ALL') {
    // ให้ใช้ค่าเกรดที่ส่งมา ผูกเป็นตัวแปร $4
    gradeCondition = "mws.grade = $4";
    // นำค่าเกรดดัน (push) เข้าไปในอาร์เรย์ params ให้ตรงกับตำแหน่ง $4
    params.push(grade);
  } 
  // ถ้าส่งคำว่า 'ALL' มา (แปลว่าต้องการดูทุกเกรดรวมกัน)
  else if (grade === 'ALL') {
    // เปลี่ยนเงื่อนไขเป็นการดึงข้อมูลทั้งหมด 4 เกรดหลักออกมา
    gradeCondition = "mws.grade IN ('AB', 'C', 'P', 'PP')";
  }

  // --- เริ่มสร้างคำสั่ง SQL ---
  const query = `
    /* ใช้ CTE (Common Table Expression) ชื่อ BaseData ในการเตรียมข้อมูลดิบขั้นแรก */
    WITH BaseData AS (
        SELECT 
            -- เลือกคอลัมน์ชื่อชุดเลื่อย
            tsw.saw_name, 
            -- เลือกคอลัมน์ความหนา
            mws.thick, 
            -- เลือกคอลัมน์ความยาว
            mws.length, 
            -- ตัดเอารหัสไม้เฉพาะ 7 ตัวท้าย (ตัด 2 ตัวหน้าทิ้ง)
            RIGHT(mws.wood_code, 7) AS wood_code,
            
            -- คำนวณฝั่ง "ไม้ปกติ" (is_special = false)
            -- หาผลรวมปริมาตรเฉพาะไม้ปกติ ถ้าใช่ให้ใช้ค่า volumn มาบวกกัน ถ้าไม่ใช่ให้บวก 0
            SUM(CASE WHEN mws.is_special = false THEN tsw.volumn ELSE 0 END) AS ab_volumn,
            -- หาผลรวมจำนวนเงินเฉพาะไม้ปกติ
            SUM(CASE WHEN mws.is_special = false THEN tsw.net_price ELSE 0 END) AS ab_amount,
            
            -- คำนวณฝั่ง "ไม้พิเศษ" (is_special = true)
            -- หาผลรวมปริมาตรเฉพาะไม้พิเศษ
            SUM(CASE WHEN mws.is_special = true THEN tsw.volumn ELSE 0 END) AS spc_volumn,
            -- หาผลรวมจำนวนเงินเฉพาะไม้พิเศษ
            SUM(CASE WHEN mws.is_special = true THEN tsw.net_price ELSE 0 END) AS spc_amount
            
        -- ข้อมูลตารางหลัก (การเลื่อยไม้)
        FROM transaction_saw_woods tsw
        -- เชื่อมตารางขนาดไม้ด้วย id (เก่า) และรหัสสาขา
        JOIN master_wood_sizes mws 
          on mws.old_id = tsw.wood_size_id 
          and tsw.branch_id = mws.branch_id
          
        -- กรองข้อมูล
        -- ใส่เงื่อนไขเกรดที่เราสร้างไว้ข้างบน (อาจเป็น AB หรือ IN ('AB','C',...))
        WHERE ${gradeCondition}
          -- เลือกช่วงวันที่ผลิต ($1, $2)
          AND DATE(tsw.produce_date) BETWEEN $1 AND $2
          -- เลือกรหัสสาขา ($3)
          AND tsw.branch_id = $3
          
        -- จับกลุ่มข้อมูลเพื่อทำการ Sum เข้าด้วยกันตามชุดเลื่อย, ความหนา, ความยาว, และรหัสไม้
        GROUP BY tsw.saw_name, mws.thick, mws.length, RIGHT(mws.wood_code, 7)
    )
    
    /* ขั้นตอนที่ 2: นำตารางจำลอง BaseData มาประมวลผลต่อ (หาเปอร์เซ็นต์และราคาเฉลี่ย) ด้วย Window Function */
    SELECT 
        saw_name, thick, length, wood_code,
        ab_volumn, ab_amount,
        
        -- หาราคาเฉลี่ย (จำนวนเงิน / ปริมาตร) ของไม้ปกติ ถ้าปริมาตรเป็น 0 ให้กัน error คืนค่า 0
        CASE WHEN ab_volumn > 0 THEN ab_amount / ab_volumn ELSE 0 END AS ab_avg_price,
        
        -- หาเปอร์เซ็นต์ (ไม้ปกติ): (ปริมาตรบรรทัดนี้ / ปริมาตรรวมทั้งหมดในชุดเลื่อย+หนา+ยาวกลุ่มนี้) * 100
        -- SUM(...) OVER (...) คือ Window function ใช้หาผลรวมโดยไม่ต้อง GROUP BY ลดแถว
        CASE WHEN SUM(ab_volumn) OVER (PARTITION BY saw_name, thick, length) > 0 
             THEN (ab_volumn / SUM(ab_volumn) OVER (PARTITION BY saw_name, thick, length)) * 100 
             ELSE 0 END AS ab_percent_qty,
             
        spc_volumn, spc_amount,
        
        -- หาราคาเฉลี่ย (จำนวนเงิน / ปริมาตร) ของไม้พิเศษ
        CASE WHEN spc_volumn > 0 THEN spc_amount / spc_volumn ELSE 0 END AS spc_avg_price,
        
        -- หาเปอร์เซ็นต์ (ไม้พิเศษ) ใช้หลักการเดียวกับไม้ปกติ
        CASE WHEN SUM(spc_volumn) OVER (PARTITION BY saw_name, thick, length) > 0 
             THEN (spc_volumn / SUM(spc_volumn) OVER (PARTITION BY saw_name, thick, length)) * 100 
             ELSE 0 END AS spc_percent_qty
             
    FROM BaseData
    -- เรียงลำดับผลลัพธ์
    ORDER BY saw_name, thick, length, wood_code;
  `;

  // สั่งยิง SQL Query ไปยัง Database พร้อมตัวแปร และดึงแค่บรรทัดคำตอบ (rows) ออกมา
  const { rows } = await pool.query(query, params);

  // --- คำนวณ Grand Total (ยอดรวมทั้งรายงาน) ---
  // กำหนดตัวแปรสะสมยอดเริ่มต้นเป็น 0
  let gt_ab_volumn = 0, gt_ab_amount = 0, gt_spc_volumn = 0, gt_spc_amount = 0;
  
  // วนลูปทุกบรรทัดผลลัพธ์จาก Database เพื่อบวกสะสม
  rows.forEach(row => {
    gt_ab_volumn += Number(row.ab_volumn || 0); // สะสมปริมาตรปกติ
    gt_ab_amount += Number(row.ab_amount || 0); // สะสมจำนวนเงินปกติ
    gt_spc_volumn += Number(row.spc_volumn || 0); // สะสมปริมาตรพิเศษ
    gt_spc_amount += Number(row.spc_amount || 0); // สะสมจำนวนเงินพิเศษ
  });

  // หายอดรวมปริมาตรสุทธิ (ปกติ + พิเศษ)
  const gt_all_volumn = gt_ab_volumn + gt_spc_volumn;

  // สร้าง Object เก็บผลสรุป Grand Total พร้อมคำนวณ % และราคาเฉลี่ยภาพรวม
  const grandTotal = {
    ab_volumn: gt_ab_volumn,
    ab_amt: gt_ab_amount,
    spc_volumn: gt_spc_volumn,
    spc_amt: gt_spc_amount,
    // % ของไม้ปกติต่อยอดรวมสุทธิ
    pct_all_ab: gt_all_volumn > 0 ? (gt_ab_volumn / gt_all_volumn) * 100 : 0,
    // % ของไม้พิเศษต่อยอดรวมสุทธิ
    pct_all_spc: gt_all_volumn > 0 ? (gt_spc_volumn / gt_all_volumn) * 100 : 0,
    // % แยกปกติ/พิเศษ (ตั้งไว้เป็น 100% เสมอเพราะเป็นผลรวมระดับบนสุด)
    pct_sep_ab: gt_ab_volumn > 0 ? 100 : 0, 
    pct_sep_spc: gt_spc_volumn > 0 ? 100 : 0,
    // ราคาเฉลี่ยรวมไม้ปกติ
    avg_price_ab: gt_ab_volumn > 0 ? (gt_ab_amount / gt_ab_volumn) : 0,
    // ราคาเฉลี่ยรวมไม้พิเศษ
    avg_price_spc: gt_spc_volumn > 0 ? (gt_spc_amount / gt_spc_volumn) : 0,
  };

  // --- จัดกลุ่มข้อมูล (Grouping) ---
  // การใช้ reduce เพื่อแปลง Array โครงสร้างแบนๆ (Flat Table) จาก Database 
  // ให้กลายเป็นโครงสร้าง Object แบบต้นไม้ซ้อนกัน (Tree structure) ตามลำดับ: ชุดเลื่อย > หนา > ยาว
  const groupedData = rows.reduce((acc, row) => {
    // เตรียมตัวแปร (ชื่อชุดเลื่อย, ความหนา, ความยาว) ไว้ใช้เป็น Key ของกลุ่ม
    const s = row.saw_name || 'ไม่ระบุชุดเลื่อย';
    const t = row.thick;
    const l = row.length;

    // ถ้ายังไม่เคยมีกลุ่ม "ชุดเลื่อย" นี้ ให้สร้างใหม่พร้อมเตรียมยอดรวมตั้งต้น
    if (!acc[s]) acc[s] = { saw_name: s, thicks: {}, total_ab_volumn: 0, total_spc_volumn: 0 };
    // ถ้ายังไม่เคยมีกลุ่ม "ความหนา" ภายใต้ชุดเลื่อยนี้ ให้สร้างใหม่
    if (!acc[s].thicks[t]) acc[s].thicks[t] = { thick: t, lengths: {}, subTotal: { ab_volumn: 0, ab_amt: 0, spc_volumn: 0, spc_amt: 0 } };
    // ถ้ายังไม่เคยมีกลุ่ม "ความยาว" ภายใต้ความหนานี้ ให้สร้างใหม่
    if (!acc[s].thicks[t].lengths[l]) acc[s].thicks[t].lengths[l] = { length: l, items: [], subTotal: { ab_volumn: 0, ab_amt: 0, spc_volumn: 0, spc_amt: 0 } };

    // นำข้อมูลระดับล่างสุด (รายละเอียดรหัสไม้บรรทัดนี้) จับยัดใส่ Array ของกลุ่ม "ความยาว"
    acc[s].thicks[t].lengths[l].items.push({
      wood_code: row.wood_code,
      ab_volumn: Number(row.ab_volumn), ab_pct_qty: Number(row.ab_percent_qty),
      ab_price: Number(row.ab_avg_price), ab_amt: Number(row.ab_amount),
      spc_volumn: Number(row.spc_volumn), spc_pct_qty: Number(row.spc_percent_qty),
      spc_price: Number(row.spc_avg_price), spc_amt: Number(row.spc_amount)
    });

    // --- สะสมยอดรวม (SubTotal) กลับขึ้นไปยังกลุ่มชั้นบนต่างๆ ทันทีที่อ่านแต่ละบรรทัดเสร็จ ---
    // 1. สะสมยอดระดับความยาว
    acc[s].thicks[t].lengths[l].subTotal.ab_volumn += Number(row.ab_volumn);
    acc[s].thicks[t].lengths[l].subTotal.ab_amt += Number(row.ab_amount);
    acc[s].thicks[t].lengths[l].subTotal.spc_volumn += Number(row.spc_volumn);
    acc[s].thicks[t].lengths[l].subTotal.spc_amt += Number(row.spc_amount);

    // 2. สะสมยอดระดับความหนา
    acc[s].thicks[t].subTotal.ab_volumn += Number(row.ab_volumn);
    acc[s].thicks[t].subTotal.ab_amt += Number(row.ab_amount);
    acc[s].thicks[t].subTotal.spc_volumn += Number(row.spc_volumn);
    acc[s].thicks[t].subTotal.spc_amt += Number(row.spc_amount);

    // 3. สะสมยอดระดับชุดเลื่อย (เก็บเฉพาะปริมาตรเพื่อใช้คำนวณ % สัดส่วนภายหลัง)
    acc[s].total_ab_volumn += Number(row.ab_volumn);
    acc[s].total_spc_volumn += Number(row.spc_volumn);

    // ส่งคืนตัวสะสมเพื่อไปทำงานในลูปต่อไป
    return acc;
  }, {}); // เริ่มต้น reduce ด้วย Object ว่างๆ {}

  // console.log(groupedData);
  // --- ประมวลผลขั้นสุดท้าย (คำนวณ % ระดับกลุ่มย่อย และแปลง Object -> Array) ---
  // Object.values() ทำการเปลี่ยน Object ที่ใช้ชื่อ Key จัดกลุ่ม เป็น Array ที่มีแต่ Value เปล่าๆ เพื่อให้ React .map() ได้
  const finalData = Object.values(groupedData).map(sawGroup => {
    // ยอดรวมทั้งหมดของชุดเลื่อย
    sawGroup.total_all_volumn = sawGroup.total_ab_volumn + sawGroup.total_spc_volumn;
    
    // แปลงกลุ่มความหนาให้เป็น Array
    sawGroup.thicks = Object.values(sawGroup.thicks).map(thickGroup => {
      // คำนวณเปอเซ็นต์ความหนา (แบบรวมทุกประเภท)
      thickGroup.pct_thick_all_ab = sawGroup.total_all_volumn > 0 ? (thickGroup.subTotal.ab_volumn / sawGroup.total_all_volumn) * 100 : 0;
      thickGroup.pct_thick_all_spc = sawGroup.total_all_volumn > 0 ? (thickGroup.subTotal.spc_volumn / sawGroup.total_all_volumn) * 100 : 0;
      // คำนวณเปอเซ็นต์ความหนา (แบบแยกปกติกับพิเศษคิดสัดส่วนเฉพาะของตัวเอง)
      thickGroup.pct_thick_sep_ab = sawGroup.total_ab_volumn > 0 ? (thickGroup.subTotal.ab_volumn / sawGroup.total_ab_volumn) * 100 : 0;
      thickGroup.pct_thick_sep_spc = sawGroup.total_spc_volumn > 0 ? (thickGroup.subTotal.spc_volumn / sawGroup.total_spc_volumn) * 100 : 0;
      // หาราคาเฉลี่ยต่อความหนา
      thickGroup.avg_price_ab = thickGroup.subTotal.ab_volumn > 0 ? (thickGroup.subTotal.ab_amt / thickGroup.subTotal.ab_volumn) : 0;
      thickGroup.avg_price_spc = thickGroup.subTotal.spc_volumn > 0 ? (thickGroup.subTotal.spc_amt / thickGroup.subTotal.spc_volumn) : 0;

      // แปลงกลุ่มความยาวให้เป็น Array
      thickGroup.lengths = Object.values(thickGroup.lengths).map(lenGroup => {
        // หา %ยาว: สัดส่วนของ "ความยาวนี้" เทียบกับ "ความหนานั้นทั้งหมด"
        lenGroup.subTotal.ab_pct_amt = thickGroup.subTotal.ab_volumn > 0 ? (lenGroup.subTotal.ab_volumn / thickGroup.subTotal.ab_volumn) * 100 : 0;
        lenGroup.subTotal.spc_pct_amt = thickGroup.subTotal.spc_volumn > 0 ? (lenGroup.subTotal.spc_volumn / thickGroup.subTotal.spc_volumn) * 100 : 0;
        return lenGroup;
      });
      return thickGroup;
    });
    return sawGroup;
  });

  // คืนค่าชุดข้อมูลที่พร้อมใช้ และผลรวมทั้งรายงาน
  return { finalData, grandTotal };
};

// --- Helper Function สำหรับดึงข้อมูลและคำนวณ (ลดความซ้ำซ้อน) ---
const fetchProductionThickMilData = async (start_date, end_date, branch_id, grade, store_code) => {
  const rows = await ReportModel.getProductionThickMilReport({ branch_id, start_date, end_date, grade, store_code });

  let grand_total_volumn = 0;
  let grand_total_amount = 0;
  const lengthSummaryMap = {};

  rows.forEach(row => {
    const vol = Number(row.ab_volumn) || 0;
    const amt = Number(row.ab_amount) || 0;
    const len = row.length;
    
    grand_total_volumn += vol;
    grand_total_amount += amt;

    if (!lengthSummaryMap[len]) lengthSummaryMap[len] = 0;
    lengthSummaryMap[len] += vol;
  });

  const grouped = rows.reduce((acc, row) => {
    const tm = row.thick_mil;
    const l = row.length;
    const vol = Number(row.ab_volumn) || 0;
    const amt = Number(row.ab_amount) || 0;

    if (!acc[tm]) {
      acc[tm] = { thick_mil: tm, thick: row.thick, lengths: {}, total_volumn: 0, total_amount: 0 };
    }
    if (!acc[tm].lengths[l]) {
      acc[tm].lengths[l] = { length: l, items: [], sub_volumn: 0, sub_amount: 0 };
    }

    acc[tm].lengths[l].items.push({
      wood_code: row.wood_code,
      ab_volumn: vol,
      ab_amount: amt,
      avg_price: vol > 0 ? amt / vol : 0
    });

    acc[tm].lengths[l].sub_volumn += vol;
    acc[tm].lengths[l].sub_amount += amt;
    acc[tm].total_volumn += vol;
    acc[tm].total_amount += amt;

    return acc;
  }, {});

  const formattedData = Object.values(grouped).map(tmGroup => {
    const lengthsArr = Object.values(tmGroup.lengths).map(lenGroup => {
      lenGroup.items = lenGroup.items.map(item => {
          item.pct_width = lenGroup.sub_volumn > 0 ? (item.ab_volumn / lenGroup.sub_volumn) * 100 : 0;
          return item;
      });
      lenGroup.pct_length = tmGroup.total_volumn > 0 ? (lenGroup.sub_volumn / tmGroup.total_volumn) * 100 : 0;
      return lenGroup;
    });

    return {
      thick_mil: tmGroup.thick_mil,
      thick: tmGroup.thick,
      lengths: lengthsArr,
      total_volumn: tmGroup.total_volumn,
      total_amount: tmGroup.total_amount,
      pct_thick_total: grand_total_volumn > 0 ? (tmGroup.total_volumn / grand_total_volumn) * 100 : 0,
      avg_price: tmGroup.total_volumn > 0 ? tmGroup.total_amount / tmGroup.total_volumn : 0
    };
  });

  const lengthSummary = Object.keys(lengthSummaryMap).sort((a,b) => Number(a) - Number(b)).map(len => {
      const vol = lengthSummaryMap[len];
      return {
        length: len,
        volumn: vol,
        pct: grand_total_volumn > 0 ? (vol / grand_total_volumn) * 100 : 0
      };
  });

  const grandTotal = {
    total_volumn: grand_total_volumn,
    total_amount: grand_total_amount,
    avg_price: grand_total_volumn > 0 ? grand_total_amount / grand_total_volumn : 0
  };

  return { formattedData, grandTotal, lengthSummary };
};

// --- Helper Function สำหรับรายงานสรุปค่าแรงจัดเรียงไม้เปียก แยกรายคน ---
const fetchWetWoodPerfDataHelper = async (branch_id, start_date, end_date, store_code) => {
  const rows = await ReportModel.getWetWoodPerformanceReport({ branch_id, start_date, end_date, store_code });

  // 1. ตั้งค่า Expected Columns ใหม่ 
  const expectedColumns = [
    { grade: 'AB', is_special: false },
    { grade: 'AB', is_special: true },
    { grade: 'C', is_special: false },
    { grade: 'C', is_special: true },
    { grade: 'P', is_special: false }, // 💡 P รวมทั้งหมด
    { grade: 'PP', is_special: false } // 💡 PP รวมทั้งหมด
  ];

  const employeeMap = {};
  
  const grandTotal = { total_volumn: 0, total_net_wage: 0 };
  expectedColumns.forEach(col => {
    const colKey = `${col.grade}_${col.is_special ? 'spc' : 'norm'}`;
    grandTotal[colKey] = { volumn: 0, net_wage: 0 };
  });

  let rowIndex = 1;

  rows.forEach(row => {
    const empCode = row.employee_code || '-';
    const empName = row.employee_name || 'ไม่ระบุชื่อ';
    const empKey = `${empCode}_${empName}`;

    if (!employeeMap[empKey]) {
      employeeMap[empKey] = {
        row_no: rowIndex++,
        employee_code: empCode,
        employee_name: empName,
        total_volumn: 0,
        total_net_wage: 0,
        grades: {}
      };
      expectedColumns.forEach(col => {
        const colKey = `${col.grade}_${col.is_special ? 'spc' : 'norm'}`;
        employeeMap[empKey].grades[colKey] = { volumn: 0, net_wage: 0 };
      });
    }

    // 2. 💡 ลอจิกรวบยอด P และ PP
    let isSpecial = row.is_special;
    if (row.grade === 'P' || row.grade === 'PP') {
      isSpecial = false; 
    }

    const colKey = `${row.grade}_${isSpecial ? 'spc' : 'norm'}`;
    const vol = Number(row.volumn) || 0;
    const wage = Number(row.net_wage) || 0;

    if (employeeMap[empKey].grades[colKey] !== undefined) {
      employeeMap[empKey].grades[colKey].volumn += vol;
      employeeMap[empKey].grades[colKey].net_wage += wage;

      employeeMap[empKey].total_volumn += vol;
      employeeMap[empKey].total_net_wage += wage;

      grandTotal[colKey].volumn += vol;
      grandTotal[colKey].net_wage += wage;
      grandTotal.total_volumn += vol;
      grandTotal.total_net_wage += wage;
    }
  });

  return { 
    formattedData: Object.values(employeeMap), 
    grandTotal,
    expectedColumns 
  };
};

// --- Helper Function สำหรับรายงานสรุปค่าแรงจัดเรียงไม้แห้ง แยกรายคน ---
// หน้าที่หลัก: รับข้อมูลดิบ (Rows) จาก Database แล้วนำมาจัดกลุ่ม (Group By) ตาม "พนักงาน" 
// เพื่อแปลงให้เป็นข้อมูลรูปแบบตาราง (Cross-tab) พร้อมคำนวณยอดรวม (Grand Total)
const fetchDryWoodPerfDataHelper = async (branch_id, start_date, end_date, store_code) => {
  
  // 1. เรียกใช้งาน Model เพื่อ Query ดึงข้อมูลดิบจาก Database ตามเงื่อนไขที่ผู้ใช้ระบุมา
  const rows = await ReportModel.getDryWoodPerformanceReport({ branch_id, start_date, end_date, store_code });

  // 2. กำหนดโครงสร้างคอลัมน์ (เกรดไม้) ที่เราคาดหวังว่าจะนำไปโชว์ในแนวนอนบนหน้าเว็บ
  // เกรด P และ PP เราจะบังคับรวม (Merge) ไม้พิเศษเข้ากับไม้ปกติ จึงตั้งค่าเป็น false อย่างเดียว
  const expectedColumns = [
    { grade: 'AB', is_special: false }, // AB ปกติ
    { grade: 'AB', is_special: true },  // AB พิเศษ
    { grade: 'C', is_special: false },  // C ปกติ
    { grade: 'C', is_special: true },   // C พิเศษ
    { grade: 'P', is_special: false },  // P รวมทั้งหมด (ปกติ + พิเศษ)
    { grade: 'PP', is_special: false }  // PP รวมทั้งหมด (ปกติ + พิเศษ)
  ];

  // 3. สร้าง Object ว่างเพื่อเตรียมไว้สำหรับจัดกลุ่มข้อมูล โดยจะใช้รหัส+ชื่อพนักงานเป็น Key ในการแยกตะกร้า
  const employeeMap = {};
  
  // 4. สร้าง Object เพื่อเตรียมเก็บผลรวมของคอลัมน์ทั้งหมด (Grand Total) ที่จะแสดงในแถวล่างสุดของตาราง
  // ตั้งค่าเริ่มต้นของยอดรวมแนวนอน (ปริมาตรรวม, ค่าแรงรวม) เป็น 0
  const grandTotal = { total_volumn: 0, total_net_wage: 0 };
  
  // วนลูปตามคอลัมน์ที่ตั้งไว้ เพื่อสร้างช่องเก็บยอดรวมของแต่ละเกรด (คอลัมน์) ในแนวตั้ง
  expectedColumns.forEach(col => {
    // สร้าง Key คอลัมน์ให้สั้นลง เช่น 'AB_norm' (ปกติ) หรือ 'AB_spc' (พิเศษ)
    const colKey = `${col.grade}_${col.is_special ? 'spc' : 'norm'}`;
    // กำหนดค่าเริ่มต้นยอดรวมแนวตั้งให้เกรดนั้นๆ เป็น 0 ทั้งปริมาตรและค่าแรง
    grandTotal[colKey] = { volumn: 0, net_wage: 0 };
  });

  // 💡 ประกาศตัวแปรนับลำดับพนักงาน (Row Number) เริ่มต้นที่ 1
  let rowIndex = 1;

  // 5. เริ่มกระบวนการจัดกลุ่มข้อมูล: วนลูปอ่านข้อมูลดิบทีละบรรทัด (Row) ที่ได้มาจากฐานข้อมูล
  rows.forEach(row => {
    
    // ดึงรหัสพนักงาน ถ้าไม่มีข้อมูลให้แทนที่ด้วย '-'
    const empCode = row.employee_code || '-';
    // ดึงชื่อพนักงาน ถ้าไม่มีข้อมูลให้แทนที่ด้วย 'ไม่ระบุชื่อ'
    const empName = row.employee_name || 'ไม่ระบุชื่อ';
    // นำรหัสและชื่อมาต่อกันเพื่อสร้าง Key ประจำตัวพนักงาน (เช่น "001_นายเอ") ใช้สำหรับเช็คความซ้ำซ้อน
    const empKey = `${empCode}_${empName}`;

    // เช็คว่าใน employeeMap มีตะกร้าของพนักงานคนนี้หรือยัง? (เครื่องหมาย ! คือ ยังไม่มี)
    if (!employeeMap[empKey]) {
      
      // ถ้ายังไม่มี (เจอพนักงานคนนี้เป็นครั้งแรก) ให้สร้างตะกร้าข้อมูลใบใหม่ให้พนักงานคนนี้
      employeeMap[empKey] = {
        row_no: rowIndex++,      // 💡 เก็บเลขลำดับปัจจุบันลงไป แล้วบวกเพิ่ม (++) รอไว้ให้คนถัดไป
        employee_code: empCode,  // เก็บข้อมูลรหัสพนักงาน
        employee_name: empName,  // เก็บข้อมูลชื่อพนักงาน
        total_volumn: 0,         // ยอดรวมปริมาตรทั้งหมดของพนักงานคนนี้ เริ่มที่ 0
        total_net_wage: 0,       // ยอดรวมค่าแรงทั้งหมดของพนักงานคนนี้ เริ่มที่ 0
        grades: {}               // Object ว่างๆ เตรียมไว้เก็บข้อมูลที่แยกตามเกรด
      };
      
      // วนลูปสร้างช่องเก็บข้อมูลย่อย (Cell) ตามจำนวนเกรดที่เราตั้งไว้
      expectedColumns.forEach(col => {
        // สร้าง Key เช่น 'AB_norm'
        const colKey = `${col.grade}_${col.is_special ? 'spc' : 'norm'}`;
        // สร้างช่องเก็บข้อมูลปริมาตรและค่าแรงของเกรดนั้น เริ่มที่ 0
        employeeMap[empKey].grades[colKey] = { volumn: 0, net_wage: 0 };
      });
    }

    // 6. ดึงข้อมูลตัวเลขของบรรทัดปัจจุบันมาเตรียมไว้ เพื่อบวกสะสมเข้าในตะกร้า
    // สร้างตัวแปรมารับค่า is_special จากฐานข้อมูลก่อน
    let isSpecial = row.is_special;
    
    // 💡 ลอจิกสำคัญ: บังคับยุบรวม P และ PP 
    // ถ้าเกรดที่อ่านมาคือ P หรือ PP เราจะบังคับให้กลายเป็นไม้ปกติเสมอ เพื่อให้มันไหลลงไปรวมในคอลัมน์เดียวกัน
    if (row.grade === 'P' || row.grade === 'PP') {
      isSpecial = false; 
    }

    // สร้าง Key ของคอลัมน์สำหรับบรรทัดปัจจุบัน (เช่น ถ้าเป็น P ก็จะกลายเป็น 'P_norm' เสมอ)
    const colKey = `${row.grade}_${isSpecial ? 'spc' : 'norm'}`;
    // แปลงค่าปริมาตรที่มาจาก DB ให้เป็นตัวเลข ถ้าพังหรือเป็นค่าว่างให้เป็น 0 ไว้ก่อน
    const vol = Number(row.volumn) || 0;
    // แปลงค่าแรงให้เป็นตัวเลข ถ้าพังหรือเป็นค่าว่างให้เป็น 0 ไว้ก่อน
    const wage = Number(row.net_wage) || 0;

    // เช็คเพื่อความปลอดภัย: เกรดที่อ่านมา มีอยู่ในโครงสร้างตะกร้าที่เราตั้งรับไว้หรือไม่? (ป้องกันเกรดหลง)
    if (employeeMap[empKey].grades[colKey] !== undefined) {
      
      // --- การสะสมยอด 4 ระดับ ---
      
      // 6.1 บวกยอดระดับบุคคล (เฉพาะเกรดนั้นๆ)
      // บวกปริมาตรสะสมเข้าไปในช่องเกรดของพนักงานคนนี้
      employeeMap[empKey].grades[colKey].volumn += vol;
      // บวกค่าแรงสะสมเข้าไปในช่องเกรดของพนักงานคนนี้
      employeeMap[empKey].grades[colKey].net_wage += wage;

      // 6.2 บวกยอดระดับบุคคล (รวมทุกเกรดเข้าด้วยกัน แถวขวาสุด)
      // บวกปริมาตรรวมของพนักงานคนนี้ 
      employeeMap[empKey].total_volumn += vol;
      // บวกค่าแรงรวมของพนักงานคนนี้
      employeeMap[empKey].total_net_wage += wage;

      // 6.3 บวกยอดระดับ Grand Total (รวมทุกคน เฉพาะเกรดนั้นๆ แถวล่างสุด)
      // บวกปริมาตรเข้ายอดรวมคอลัมน์ของเกรดนั้นๆ ระดับบริษัท
      grandTotal[colKey].volumn += vol;
      // บวกค่าแรงเข้ายอดรวมคอลัมน์ของเกรดนั้นๆ ระดับบริษัท
      grandTotal[colKey].net_wage += wage;
      
      // 6.4 บวกยอดระดับ Grand Total สุทธิ (รวมทุกคน ทุกเกรด มุมขวาล่างสุด)
      // บวกปริมาตรเข้ายอดรวมสุทธิทั้งรายงาน
      grandTotal.total_volumn += vol;
      // บวกค่าแรงเข้ายอดรวมสุทธิทั้งรายงาน
      grandTotal.total_net_wage += wage;
    }
  });

  // 7. จัดการข้อมูลก่อนส่งคืน (Return)
  return { 
    // Object.values() จะแปลง Object ที่เราใช้เป็นตะกร้า ให้กลายเป็น Array เพื่อให้ React นำไป .map() สร้างแถวได้
    formattedData: Object.values(employeeMap), 
    grandTotal,         // ยอดรวมทั้งหมด (Grand Total)
    expectedColumns     // โครงสร้างคอลัมน์ (เอาไว้ให้ React สร้างหัวตารางและวนลูปสร้างคอลัมน์)
  };
};

