      res.setHeader('Content-Disposition', 'inline; filename="dry_wood_perf.pdf"');
      res.send(pdfBuffer);
    } catch (error) {
      console.error(error);
      res.status(500).json({ success: false, message: 'Error PDF' });
    }
  },
  
};

module.exports = reportController;
