      res.json({
        success: true,
        data: {
          header: { start_date, end_date, store_code: store_code || '104%' }, // 💡 แนบกลับไปแสดงผล
          groups: Object.values(groupedData)
        }
      });
    } catch (error) {
      console.error('Report Error:', error);
