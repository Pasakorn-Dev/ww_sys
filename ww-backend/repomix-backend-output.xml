const express = require('express');
const router = express.Router();
const transactionController = require('../controllers/transactionController');
const verifyToken = require('../middlewares/authMiddleware');
const checkPermission = require('../middlewares/permissionMiddleware');

// API ซิงค์ข้อมูลเลื่อยไม้ (ต้องการสิทธิ์แอดมินหรือเพิ่มข้อมูล)
router.post('/sync-saw-woods', verifyToken, checkPermission('/sync-saw-woods', 'add'), transactionController.syncSawWoods);
// ดึงข้อมูลนับไม้เลื่อย
router.get('/saw-woods', verifyToken, checkPermission('/check-saw-woods', 'view'), transactionController.getSawWoods);

// API สำหรับการคำนวณราคาย้อนหลัง
router.post('/recalculate-prices', verifyToken, checkPermission('/recalculate-price', 'edit'), transactionController.recalculatePrices);
router.get('/recal-logs', verifyToken, transactionController.getRecalLogs);

// API ซิงค์ข้อมูลไม้เปียก (ต้องการสิทธิ์แอดมินหรือเพิ่มข้อมูล)
router.post('/sync-wet-woods', verifyToken, checkPermission('/sync-wet-woods', 'add'), transactionController.syncWetWoods);

// API ซิงค์ข้อมูลไม้แห้ง
router.post('/sync-dry-woods', verifyToken, checkPermission('/sync-dry-woods', 'add'), transactionController.syncDryWoods);

// ดึงข้อมูลรายละเอียดการนับไม้เปียก
router.get('/wet-woods', verifyToken, checkPermission('/wet-wood-data', 'view'), transactionController.getWetWoods);

// ดึงข้อมูลรายละเอียดการนับไม้แห้ง
router.get('/dry-woods', verifyToken, checkPermission('/dry-wood-data', 'view'), transactionController.getDryWoods);

module.exports = router;
</file>

<file path="src/cronJobs.js">
const cron = require('node-cron');
const masterController = require('./controllers/masterController');

// จำลองระบบหลอกว่ามี Request/Response เพื่อสั่งให้ Controller ทำงาน
const runAutoSync = async () => {
    console.log(`[Cron] ⏳ เริ่มกระบวนการซิงค์ข้อมูลอัตโนมัติ: ${new Date().toLocaleString('th-TH')}`);
    
    // จำลอง Request ให้ branch_id = 0 (แปลว่าสั่งอัปเดตทุกสาขา)
    const mockReq = { body: { branch_id: 0 } };
    
    // จำลอง Response เพื่อรับผลลัพธ์จาก Controller กลับมาพิมพ์ใน Log
    const mockRes = {
        status: function(code) {
            return this; // ให้ Chain .json() ต่อได้
        },
        json: function(data) {
            console.log(`[Cron] 🏁 ผลลัพธ์: ${data.message} (ใช้เวลา ${data.sync_time} วิ)`);
        }
    };

    try {
        await masterController.syncMasterData(mockReq, mockRes);
    } catch (error) {
        console.error('[Cron] ❌ เกิดข้อผิดพลาดร้ายแรง:', error);
    }
};

// ----------------------------------------------------
// ตั้งเวลาทำงาน: ตัวอย่างตั้งไว้ที่ 02:00 น. (ตี 2 ของทุกวัน)
// ----------------------------------------------------
// รูปแบบ: 'นาที ชั่วโมง วันที่ เดือน วันในสัปดาห์'
cron.schedule('0 2 * * *', () => {
    runAutoSync();
}, {
    scheduled: true,
    timezone: "Asia/Bangkok" // บังคับให้เป็นโซนเวลาประเทศไทยเสมอ
});

console.log('✅ ระบบ Auto-Sync ตั้งเวลาทำงานอัตโนมัติ (ตี 2 ทุกวัน) พร้อมทำงานแล้ว');

// เพิ่มบรรทัดนี้เพื่อบังคับให้มันทำงานทันที 1 รอบตอนที่ Server Start
runAutoSync();

module.exports = cron;
</file>

<file path="src/server.js">
const express = require('express');
const cors = require('cors');
require('dotenv').config();
// require('./cronJobs'); // เปิดใช้งานระบบตั้งเวลาอัตโนมัติเบื้องหลัง

const app = express();

// Middlewares
app.use(cors()); // อนุญาตให้ Frontend เชื่อมต่อเข้ามาได้
app.use(express.json()); // ให้ Express อ่านข้อมูลแบบ JSON ได้

// Routes
const branchRoutes = require('./routes/branchRoutes');
const authRoutes = require('./routes/authRoutes');
const menuRoutes = require('./routes/menuRoutes');
// const productRoutes = require('./routes/productRoutes'); // นำเข้าการจัดการเส้นทางสินค้า
const masterRoutes = require('./routes/masterRoutes');
const transactionRoutes = require('./routes/transactionRoutes');
const masterOptionsRoutes = require('./routes/masterOptionsRoutes');
const reportRoutes = require('./routes/reportRoutes');
const dashboardRoutes = require('./routes/dashboardRoutes');


app.use('/api/master', masterRoutes);

app.use('/api/branches', branchRoutes); // เปิดใช้งาน API สาขา
// app.use('/api/products', productRoutes); // เปิดใช้งาน API สินค้า

app.use('/api/auth', authRoutes);
app.use('/api/menus', menuRoutes); // เปิดใช้งาน API เมนู

app.use('/api/transactions', transactionRoutes);

app.use('/api/master-options', masterOptionsRoutes);

app.use('/api/reports', reportRoutes);

app.use('/api/dashboard', dashboardRoutes);

// Test Route เพื่อตรวจสอบสถานะ
app.get('/api/status', (req, res) => {
    res.json({
        success: true,
        message: 'Backend API พร้อมทำงาน! รอรับโครงสร้าง Database จากคุณ PPOS ครับ'
    });
});

// ตั้งค่า Port (ดึงจาก .env ถ้าไม่มีให้ใช้ 5000)
const PORT = process.env.PORT || 5000;

app.listen(PORT, () => {
    console.log(`[Backend] Server is running on port ${PORT}`);
});
