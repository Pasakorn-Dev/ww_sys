coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#t-storage)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node_modules (ห้ามอัปโหลดขึ้น GitHub เด็ดขาด โหลดใหม่ด้วย npm install เอาบนเครื่องเซิร์ฟเวอร์)
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Build output
dist
build

# Local environment files (ข้อมูลสำคัญ เช่น ข้อมูลเชื่อมต่อฐานข้อมูล PostgreSQL, รหัสผ่าน, JWT Secret)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

